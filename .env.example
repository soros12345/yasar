# RevenueOS V1A-0 environment contract — EXAMPLE ONLY. Contains no secrets.
# Copy to .env (gitignored) and adjust for your machine.

# --- identity / build ---
ENVIRONMENT=development
APP_VERSION=0.1.0+v1a0
LOG_LEVEL=INFO
LOG_FORMAT=json

# --- API / web ---
API_HOST=127.0.0.1
API_PORT=8000
API_BASE_URL=http://127.0.0.1:8000
WEB_HOST=0.0.0.0
WEB_PORT=3000
NEXT_PUBLIC_API_BASE_URL=/api
API_PROXY_TARGET=http://127.0.0.1:8000

# --- PostgreSQL (native, no Docker) ---
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=revenueos_core
POSTGRES_USER=revenueos
# Local development password. Generate your own value; .env is gitignored.
POSTGRES_PASSWORD=CHANGE_ME_local_dev_password

# --- Valkey (native, no Docker) ---
VALKEY_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2

# --- scheduler (APScheduler = single schedule authority) ---
SCHEDULER_HEARTBEAT_INTERVAL_SECONDS=10
SCHEDULER_HEARTBEAT_TTL_SECONDS=45
SCHEDULER_LOCK_TTL_SECONDS=60
# Test-only schedule must stay false in production bootstrap configuration.
SCHEDULER_TEST_JOB_ENABLED=false
SCHEDULER_TEST_JOB_INTERVAL_SECONDS=30

# --- sessions / credentials (V1A-1) ---
SESSION_TTL_HOURS=12
PBKDF2_ITERATIONS=600000
