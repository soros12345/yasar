# AlphaFold Platform - Ortam Değişkenleri

# Uygulama
APP_NAME="AlphaFold Platform"
APP_VERSION="1.0.0"
DEBUG=false

# API Server
API_HOST=0.0.0.0
API_PORT=8000

# UI Server
UI_HOST=0.0.0.0
UI_PORT=8501

# Cache
CACHE_DIR=./cache
CACHE_TTL=86400

# Providers
PROVIDERS_DIR=./providers
ACTIVE_PROVIDERS=alphafold_db

# AlphaFold DB Configuration
ALPHAFOLD_DB_API_URL=https://alphafolddb.csb.pitt.edu/api/v1
ALPHAFOLD_DB_TIMEOUT=30
ALPHAFOLD_DB_MAX_RETRIES=3

# Analysis Parameters
RMSD_THRESHOLD=2.0
PLDDT_THRESHOLD=70.0
POCKET_GRID_SIZE=1.0
